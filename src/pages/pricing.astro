---
import PageLayout from '../layouts/PageLayout.astro';
import SectionDivider from '../components/SectionDivider.astro';
import CTABanner from '../components/CTABanner.astro';

const base = import.meta.env.BASE_URL;

const rows = [
  {
    title: '一般建築金物 施工図',
    detail: 'A1 / A2 サイズ ／ 手摺・タラップ・パネル等',
    price: '¥8,000',
    unit: '〜 / 枚',
  },
  {
    title: 'アルミ既製品 施工図',
    detail: 'A1 / A2 サイズ ／ アルミ手摺・隔て板・笠木等',
    price: '¥4,000',
    unit: '〜 / 枚',
  },
  {
    title: '訂正・チェックバック対応',
    detail: '意匠変更・仕様変更に伴う図面訂正',
    price: '¥2,000',
    unit: '〜 / 時間',
  },
];

const notes = [
  '当方の作図ミスに起因する修正は無償で対応いたします',
  '複雑な図面・特殊仕様の場合は別途ご相談',
  '物量によるボリュームディスカウントあり／お見積りは無料です',
];
---

<PageLayout
  title="料金について | 山全金物設計所"
  description="建築金物施工図の料金について。一般施工図8,000円〜、アルミ既製品施工図4,000円〜、訂正2,000円〜。物量によりお見積り。"
  heroTitle="料金について"
  heroSubtitle="PRICING"
  heroBgImage="bg/pricing-bg.webp"
  breadcrumb={[
    { label: 'HOME', href: `${base}/` },
    { label: '料金' },
  ]}
>

  <!-- ===== Section 1: 料金表 — DARK background ===== -->
  <section class="py-20 px-4 relative overflow-hidden" style="background-color: #1c1c38;">
    <!-- Section top gradient line (animated) -->
    <div class="absolute top-0 left-0 right-0 section-topline"></div>
    <div class="absolute top-0 left-0 w-1/2 h-1/2 pointer-events-none" style="background: radial-gradient(ellipse at top left, rgba(196,163,90,0.05) 0%, transparent 65%);"></div>
    <div class="max-w-5xl mx-auto relative z-10">

      <div class="price-table reveal rounded-xl px-6 py-10 md:px-12 md:py-11">

        <!-- Intro -->
        <p class="text-center text-base md:text-lg leading-loose text-gray-300 mb-9">
          図面の種類・物量に応じて個別にお見積りいたします。<br />
          お気軽にお問い合わせください。
        </p>

        <!-- Rate rows -->
        <div class="flex flex-col">
          {rows.map((row) => (
            <div class="price-row flex flex-col gap-2 py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
              <div>
                <p class="text-lg md:text-xl font-medium text-white mb-1">{row.title}</p>
                <p class="text-sm text-gray-400">{row.detail}</p>
              </div>
              <p class="flex-shrink-0 whitespace-nowrap">
                <span class="gradient-text text-3xl md:text-4xl font-bold">{row.price}</span><span class="text-sm md:text-base text-gray-400">{row.unit}</span>
              </p>
            </div>
          ))}
        </div>

        <!-- Notes -->
        <div class="mt-8 rounded-lg px-6 py-6 md:px-7" style="background-color: #0f0f1a;">
          <ul class="flex flex-col gap-3">
            {notes.map((note) => (
              <li class="flex items-start gap-3 text-sm md:text-base leading-relaxed text-gray-300">
                <span class="flex-shrink-0 font-bold" style="color: #4a6fa5;">※</span>
                <span>{note}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- 上のセクション(#1c1c38)から CTA(dark-bg) への継ぎ目。fromColor は直上のセクション色と一致させる -->
  <SectionDivider direction="left" fromColor="#1c1c38" toColor="dark-bg" />

  <!-- CTA -->
  <div class="bg-dark-bg pb-4">
    <CTABanner
      title="まずはお気軽にお見積り依頼を"
      description="物量・仕様に応じた個別お見積りを無料で承ります。LINEまたはメールでお気軽にご連絡ください。"
      buttonText="お問い合わせ・お見積り依頼"
      buttonHref="/contact/"
    />
  </div>

</PageLayout>

<style>
  .price-table {
    background-color: #1a1a2e;
    border: 1px solid rgba(74, 111, 165, 0.35);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
  }

  /* Row separator — the last row keeps its rule so the block reads as a table */
  .price-row {
    border-bottom: 1px solid rgba(74, 111, 165, 0.3);
  }
</style>
